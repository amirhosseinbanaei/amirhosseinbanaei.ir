---
const {title, description} = Astro.props;
---

<div class="mx-auto w-full md:w-3/4 space-y-5">
  {
    title && (
      <h1 class="text-center text-7xl font-bold text-typography-primary">
        {title}
      </h1>
    )
  }
  {
    description && (
      <p class="text-md text-center text-typography-secondary lg:text-xl lg:leading-8 fa:leading-8 fa:text-lg">
        {description}
      </p>
    )
  }
</div>
