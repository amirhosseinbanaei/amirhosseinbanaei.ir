---
import { Image } from "astro:assets";

const { data, reverse, t } = Astro.props;
const locale = Astro.currentLocale as string;
---

<section
  class={`flex w-full flex-col gap-10 2xl:px-10 ${reverse ? "md:flex-row" : "md:flex-row-reverse"}`}
>
  <section class="h-full w-full md:w-1/2 lg:w-1/3 xl:w-2/5">
    <div class="relative aspect-video w-full rounded-2xl">
      <Image
        width={1524}
        height={729}
        src={`/projects/${data.image}`}
        alt={`${data.en.title} project`}
        class="rounded-md"
      />
    </div>
  </section>
  <section
    class="flex w-full flex-col justify-center gap-5 px-5 md:w-1/2 md:px-0 lg:w-2/3 xl:w-3/5"
  >
    <h1 class="text-xl font-bold text-typography-primary xl:text-4xl">
      {data[locale].title}
    </h1>
    <p class="leading-7 text-typography-primary opacity-80 xl:leading-7">
      {data[locale].description}
    </p>
    {
      data.links && (
        <section class="mt-3 flex w-full items-center gap-5">
          {data.links.preview && (
            <a target="_blank" href={data.links.preview}>
              <button class="rounded-lg bg-typography-secondary px-5 py-3 tracking-wide text-typography-primary">
                {t.Projects.buttons.preview}
              </button>
            </a>
          )}
          {data.links.github && (
            <a target="_blank" href={data.links.github}>
              <button class="rounded-lg border border-typography-secondary px-5 py-3 tracking-wide text-typography-primary">
                {t.Projects.buttons.github}
              </button>
            </a>
          )}
        </section>
      )
    }
  </section>
</section>
